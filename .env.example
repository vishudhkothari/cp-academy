# Copy to .env.local and fill in. Never commit .env.local.

# Supabase Postgres (Prisma). Password special chars must be URL-encoded (@ -> %40).
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR_REF.supabase.co:5432/postgres"

# Supabase client / Auth
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, admin
SUPABASE_SECRET_KEY="sb_secret_..."                  # optional new-format secret

# Competitive-programming handles
CF_HANDLE="your-codeforces-handle"
ATCODER_HANDLE="your-atcoder-handle"

# Code execution (sample/custom runs)
PISTON_URL="https://emkc.org/api/v2/piston"

# AI coaching mode: "scaffold" | "api"
COACH_MODE="scaffold"

# Single-user password gate. LEAVE UNSET locally (app stays open).
# SET this in production (Vercel env) to require a password on the public URL.
APP_PASSWORD=""
